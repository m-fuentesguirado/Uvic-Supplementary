/*
 * Standalone publication configuration.
 * Scientific process settings are copied unchanged in conf/modules/fastq_to_dx.config.
 * No institution-specific paths, patient files or multicaller configuration are loaded.
 */
params {
    input = null
    outdir = 'results'
    ref_fasta = null
    ref_fasta_fai = null
    ref_dict = null
    bwamem2_index = null
    panel_intervals = null
    bait_intervals = null
    target_intervals = null

    // Preserved from FINAL_CLEAN, commit 6dba9e414e2f70f069f82b9fa58e69298bfbb14d.
    duplex_min_reads = '2 1 1'
    duplex_min_input_baseq = 20
    duplex_min_base_quality = 45
    duplex_max_base_error_rate = 0.2

    // The original local MarkDuplicates process has no environment declaration.
    // Supply the original study environment or a separately validated replacement.
    dedup_conda_env = null
    trace_report_suffix = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules/fastq_to_dx.config'

process.executor = 'local'
process.shell = ['bash', '-C', '-e', '-u', '-o', 'pipefail']
conda.enabled = false
docker.enabled = false
singularity.enabled = false
apptainer.enabled = false
nextflow.enable.configProcessNamesValidation = false

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER = '/.Rprofile'
    R_ENVIRON_USER = '/.Renviron'
}

profiles {
    native {
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        conda.channels = ['conda-forge', 'bioconda']
        process {
            withName: 'GATK_MARKDUPLICATES' {
                conda = { params.dedup_conda_env }
            }
        }
    }
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report_${params.trace_report_suffix}.html"
}
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace_${params.trace_report_suffix}.tsv"
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/dag_${params.trace_report_suffix}.html"
}

manifest {
    name = 'ctdna-fastq-to-dx-thesis'
    description = 'FASTQ-to-duplex-consensus source package for thesis supplementary methods'
    mainScript = 'main.nf'
    nextflowVersion = '!>=25.10.4'
    version = '0.1.0-supplementary-draft'
}
